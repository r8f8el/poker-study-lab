# Poker Study Lab - Environment Configuration Template
# (Do NOT commit real secret keys into version control)

# App Environment
NODE_ENV=development
APP_PORT=5173
APP_HOST=127.0.0.1

# Capture & Vision Settings
DEFAULT_FPS=15
AUTHORIZED_APP_IDENTIFIER=com.auth.poker.client
ENABLE_LOCAL_VISION_SERVICE=true
VISION_SERVICE_PORT=8000
VISION_SERVICE_TOKEN=local_ephemeral_dev_token_example

# Confidence Thresholds
CONFIDENCE_AUTO_ACCEPT=0.98
CONFIDENCE_TEMPORAL_ACCEPT=0.95
CONFIDENCE_PROBABLE=0.85
TEMPORAL_WINDOW_FRAMES=7
TEMPORAL_CONSENSUS_FRAMES=5

# Optional AI Explanation Provider (Optional didactic layer only)
# Decisions are always computed deterministically by the local engine
AI_EXPLANATION_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_URL=http://127.0.0.1:11434
